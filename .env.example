# Copia este archivo como .env o completa las credenciales desde la pantalla de configuración inicial.
# Nunca subas el archivo .env al repositorio.

# API key de Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# API key de HeyGen (opcional, habilita los reels con avatar): https://app.heygen.com/developers/api
HEYGEN_API_KEY=

# Reels (opcional): minutos máximos esperando a que HeyGen termine un video antes de marcarlo con error.
HEYGEN_POLL_TIMEOUT_MIN=30

# Servidor (opcional)
PORT=3001
HOST=127.0.0.1
