{
  "name": "server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/core/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/core/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "node --import tsx --test test/heygenClient.test.ts test/jobRunner.test.ts test/reelsHelpers.test.ts",
    "probar:heygen": "tsx scripts/probarHeygen.ts"
  },
  "dependencies": {
    "@google/genai": "^1.30.0",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "multer": "^2.0.2",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0"
  }
}
